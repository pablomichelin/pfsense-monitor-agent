<?xml version="1.0" encoding="utf-8" ?>
<packagegui>
  <copyright>SystemUp</copyright>
  <name>SystemUp Monitor</name>
  <version>%%PKGVERSION%%</version>
  <title>Services: SystemUp Monitor</title>
  <include_file>/usr/local/pkg/systemup_monitor.inc</include_file>
  <menu>
    <name>SystemUp Monitor</name>
    <section>Services</section>
    <configfile>systemup_monitor.xml</configfile>
    <tooltiptext>Configure o agente leve do Monitor-Pfsense.</tooltiptext>
    <url>/config_systemup_monitor.php</url>
  </menu>
  <menu>
    <name>SystemUp Monitor</name>
    <section>Status</section>
    <configfile>systemup_monitor.xml</configfile>
    <tooltiptext>Diagnostico e status do agente Monitor-Pfsense.</tooltiptext>
    <url>/status_systemup_monitor.php</url>
  </menu>
  <service>
    <name>monitor_pfsense_agent</name>
    <description>SystemUp Monitor Agent</description>
    <rcfile>monitor_pfsense_agent</rcfile>
    <custom_php_service_status_command>$rc = (mwexec("/usr/sbin/service monitor_pfsense_agent onestatus >/dev/null 2>&amp;1") == 0);</custom_php_service_status_command>
  </service>
  <tabs>
    <tab>
      <text>Configuracao</text>
      <url>/config_systemup_monitor.php</url>
      <active/>
    </tab>
    <tab>
      <text>Diagnostico</text>
      <url>/status_systemup_monitor.php</url>
    </tab>
    <tab>
      <text>Backup</text>
      <url>/backup_systemup_monitor.php</url>
    </tab>
  </tabs>
  <custom_php_validation_command>systemup_monitor_validate_package_input($input_errors);</custom_php_validation_command>
  <custom_php_resync_config_command>systemup_monitor_sync_config();</custom_php_resync_config_command>
  <custom_php_deinstall_command>systemup_monitor_package_uninstall();</custom_php_deinstall_command>
  <custom_php_after_head_command>systemup_monitor_render_config_section_header();</custom_php_after_head_command>
  <fields>
    <field>
      <fielddescr>Descricao</fielddescr>
      <fieldname>description</fieldname>
      <description>Identificacao desta instancia na lista; padrao Agente Principal.</description>
      <type>input</type>
      <size>40</size>
    </field>
    <field>
      <fielddescr>Enable package</fielddescr>
      <fieldname>enabled</fieldname>
      <description>Habilita o agente local, grava a configuracao e inicia o servico rc.d.</description>
      <type>checkbox</type>
    </field>
    <field>
      <fielddescr>Controller URL</fielddescr>
      <fieldname>controller_url</fieldname>
      <description>URL publica do controlador central.</description>
      <type>input</type>
      <size>60</size>
    </field>
    <field>
      <fielddescr>Node UID</fielddescr>
      <fieldname>node_uid</fieldname>
      <description>Identidade estavel do firewall no controlador. Obrigatorio para o runtime.</description>
      <type>input</type>
      <size>48</size>
    </field>
    <field>
      <fielddescr>Customer code</fielddescr>
      <fieldname>customer_code</fieldname>
      <description>Codigo do cliente no controlador. Obrigatorio para o runtime.</description>
      <type>input</type>
      <size>32</size>
    </field>
    <field>
      <fielddescr>Heartbeat interval</fielddescr>
      <fieldname>interval_seconds</fieldname>
      <description>Intervalo em segundos entre heartbeats do agente.</description>
      <type>input</type>
      <size>8</size>
    </field>
    <field>
      <fielddescr>Monitor DNS Resolver</fielddescr>
      <fieldname>service_unbound</fieldname>
      <description>Inclui o unbound no calculo de saude deste firewall.</description>
      <type>checkbox</type>
    </field>
    <field>
      <fielddescr>Monitor DHCP Server</fielddescr>
      <fieldname>service_dhcpd</fieldname>
      <description>Inclui o dhcpd no calculo de saude deste firewall.</description>
      <type>checkbox</type>
    </field>
    <field>
      <fielddescr>Monitor Gateway Monitoring</fielddescr>
      <fieldname>service_dpinger</fieldname>
      <description>Inclui o dpinger no calculo de saude deste firewall.</description>
      <type>checkbox</type>
    </field>
    <field>
      <fielddescr>Monitor OpenVPN</fielddescr>
      <fieldname>service_openvpn</fieldname>
      <description>Inclui o OpenVPN no calculo de saude deste firewall.</description>
      <type>checkbox</type>
    </field>
    <field>
      <fielddescr>Monitor IPsec</fielddescr>
      <fieldname>service_ipsec</fieldname>
      <description>Inclui o IPsec no calculo de saude deste firewall.</description>
      <type>checkbox</type>
    </field>
    <field>
      <fielddescr>Monitor WireGuard</fielddescr>
      <fieldname>service_wireguard</fieldname>
      <description>Inclui o WireGuard no calculo de saude deste firewall.</description>
      <type>checkbox</type>
    </field>
    <field>
      <fielddescr>Monitor NTP sync</fielddescr>
      <fieldname>service_ntpd</fieldname>
      <description>Inclui o NTP no calculo de saude deste firewall.</description>
      <type>checkbox</type>
    </field>
    <field>
      <fielddescr>Pacotes adicionais (Fase B)</fielddescr>
      <fieldname>monitored_packages_csv</fieldname>
      <description>Pacotes do pfSense a monitorar alem dos servicos nativos. Lista separada por virgula; opcionalmente use ":critical" ou ":optional" por pacote (ex: haproxy,suricata,squid:optional). Optional nao degrada o node. Catalogo de referencia instalado em /usr/local/share/pfSense-pkg-systemup-monitor/package-monitor-catalog.json.</description>
      <type>textarea</type>
      <rows>3</rows>
      <cols>60</cols>
    </field>
    <field>
      <fielddescr>Heartbeat mode</fielddescr>
      <fieldname>heartbeat_mode</fieldname>
      <description>normal envia servicos e gateways; light envia apenas telemetria essencial.</description>
      <type>select</type>
      <options>
        <option>
          <name>Normal</name>
          <value>normal</value>
        </option>
        <option>
          <name>Light</name>
          <value>light</value>
        </option>
      </options>
    </field>
    <field>
      <fielddescr>Node secret (runtime)</fielddescr>
      <fieldname>secret_stored</fieldname>
      <description>Indica que o segredo HMAC esta em /var/db/monitor-pfsense-agent/node_secret (0600). Rotacao via controlador (rekey).</description>
      <type>checkbox</type>
    </field>
    <field>
      <fielddescr>Node secret (legado)</fielddescr>
      <fieldname>node_secret</fieldname>
      <description>Campo legado — apos bootstrap o valor fica no arquivo runtime. Deixe vazio quando secret_stored estiver ativo.</description>
      <type>password</type>
      <size>64</size>
    </field>
    <field>
      <fielddescr>Backup automatico</fielddescr>
      <fieldname>config_backup_enabled</fieldname>
      <description>Habilita envio agendado de config.xml ao controlador.</description>
      <type>checkbox</type>
    </field>
    <field>
      <fielddescr>Modo de agendamento backup</fielddescr>
      <fieldname>config_backup_schedule_mode</fieldname>
      <description>hours, daily, weekly ou monthly.</description>
      <type>select</type>
      <options>
        <option><name>A cada X horas</name><value>hours</value></option>
        <option><name>Diariamente</name><value>daily</value></option>
        <option><name>Semanalmente</name><value>weekly</value></option>
        <option><name>Mensalmente</name><value>monthly</value></option>
      </options>
    </field>
    <field>
      <fielddescr>Intervalo backup (horas)</fielddescr>
      <fieldname>config_backup_interval_hours</fieldname>
      <description>Usado quando modo hours.</description>
      <type>input</type>
      <size>8</size>
    </field>
    <field>
      <fielddescr>Horario backup (HH:MM)</fielddescr>
      <fieldname>config_backup_schedule_time</fieldname>
      <description>Horario local para daily/weekly/monthly.</description>
      <type>input</type>
      <size>8</size>
    </field>
    <field>
      <fielddescr>Dia da semana backup</fielddescr>
      <fieldname>config_backup_schedule_dow</fieldname>
      <description>0=domingo .. 6=sabado (modo weekly).</description>
      <type>input</type>
      <size>4</size>
    </field>
    <field>
      <fielddescr>Dia do mes backup</fielddescr>
      <fieldname>config_backup_schedule_dom</fieldname>
      <description>1-28 (modo monthly).</description>
      <type>input</type>
      <size>4</size>
    </field>
    <field>
      <fielddescr>Backup somente se mudou</fielddescr>
      <fieldname>config_backup_on_change</fieldname>
      <description>Pula upload se hash do XML nao mudou.</description>
      <type>checkbox</type>
    </field>
    <field>
      <fielddescr>Compactar backup (gzip)</fielddescr>
      <fieldname>config_backup_compress</fieldname>
      <description>Envia payload compactado.</description>
      <type>checkbox</type>
    </field>
    <field>
      <fielddescr>Aceitar backup remoto</fielddescr>
      <fieldname>config_backup_accept_remote_requests</fieldname>
      <description>Executa config_backup_now recebido no heartbeat.</description>
      <type>checkbox</type>
    </field>
  </fields>
</packagegui>
