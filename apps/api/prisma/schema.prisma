generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EntityStatus {
  active
  inactive

  @@map("entity_status")
}

enum NodeStatus {
  online
  degraded
  offline
  maintenance
  unknown

  @@map("node_status")
}

enum ServiceStatus {
  running
  stopped
  degraded
  unknown
  not_installed

  @@map("service_status")
}

enum GatewayStatus {
  online
  degraded
  down
  unknown

  @@map("gateway_status")
}

enum AlertStatus {
  open
  acknowledged
  resolved

  @@map("alert_status")
}

enum AlertType {
  heartbeat_missing
  service_down
  gateway_down
  version_change
  agent_error
  node_uid_conflict
  clock_skew
  auth_failure_repeated
  certificate_expiring

  @@map("alert_type")
}

enum AlertSeverity {
  critical
  warning
  info

  @@map("alert_severity")
}

enum NodeUidStatus {
  active
  conflict
  retired

  @@map("node_uid_status")
}

enum NodeCredentialStatus {
  active
  rotated
  revoked

  @@map("node_credential_status")
}

enum NodeCapabilityAccessMode {
  unknown
  direct
  agent
  manual

  @@map("node_capability_access_mode")
}

enum NodeExternalCredentialType {
  pfrest_api

  @@map("node_external_credential_type")
}

enum NodeExternalCredentialAuthMethod {
  api_key
  bearer_token

  @@map("node_external_credential_auth_method")
}

enum NodeExternalCredentialStatus {
  active
  rotated
  revoked

  @@map("node_external_credential_status")
}

enum NodeCredentialEventType {
  created
  rotated
  revoked
  test_success
  test_failure

  @@map("node_credential_event_type")
}

enum AgentTokenStatus {
  active
  expired
  revoked

  @@map("agent_token_status")
}

enum ConfigBackupStatus {
  stored
  duplicate
  rejected
  failed

  @@map("config_backup_status")
}

enum NodeCommandType {
  config_backup_now
  pfsense_upgrade
  package_upgrade
  service_restart
  node_reboot
  local_user_create
  local_user_set_password
  local_user_disable
  local_user_delete

  @@map("node_command_type")
}

enum TechnicianStatus {
  active
  revoked

  @@map("technician_status")
}

enum TechnicianNodeAccountStatus {
  pending_create
  active
  password_reset_pending
  disabled
  removed
  failed

  @@map("technician_node_account_status")
}

enum NodeCommandStatus {
  pending
  picked_up
  running
  succeeded
  failed
  expired
  cancelled

  @@map("node_command_status")
}

enum JobBatchStatus {
  pending
  running
  completed
  cancelled
  failed

  @@map("job_batch_status")
}

enum NotificationChannelType {
  email
  webhook
  telegram

  @@map("notification_channel_type")
}

enum NotificationChannelStatus {
  active
  inactive

  @@map("notification_channel_status")
}

enum NotificationDeliveryStatus {
  pending
  sending
  delivered
  failed

  @@map("notification_delivery_status")
}

enum NodeCriticality {
  critical
  standard
  lab

  @@map("node_criticality")
}

model Role {
  code             String           @id
  label            String
  isSystem         Boolean          @default(false) @map("is_system")
  status           EntityStatus     @default(active)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  users            User[]
  rolePermissions  RolePermission[]

  @@map("roles")
}

model Client {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  code      String       @unique
  status    EntityStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  sites     Site[]
  userScopes UserClientScope[]
  clientUsers User[] @relation("ClientProfileUsers")
  auditLogs AuditLog[]
  notificationRules NotificationRule[]
  tags              Tag[]
  nodeGroups        NodeGroup[]

  @@map("clients")
}

model User {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String       @unique
  displayName String?      @map("display_name")
  passwordHash String?     @map("password_hash")
  role        String       @default("readonly")
  status      EntityStatus @default(active)
  clientId    String?      @map("client_id") @db.Uuid
  // C-MFA: segredo TOTP cifrado em repouso (mesmo padrao aes-256-gcm do node_secret).
  mfaEnabled   Boolean     @default(false) @map("mfa_enabled")
  mfaSecret    String?     @map("mfa_secret")
  mfaEnrolledAt DateTime?  @map("mfa_enrolled_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions    UserSession[]
  roleRef     Role         @relation(fields: [role], references: [code], onDelete: Restrict)
  client      Client?      @relation("ClientProfileUsers", fields: [clientId], references: [id], onDelete: SetNull)
  clientScopes UserClientScope[]
  grantedClientScopes UserClientScope[] @relation("UserClientScopeGrantedBy")
  mfaRecoveryCodes MfaRecoveryCode[]
  mfaChallenges    MfaLoginChallenge[]

  @@index([clientId])
  @@map("users")
}

// C-MFA: codigos de recuperacao de MFA (hash sha256, consumo unico).
model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId])
  @@map("mfa_recovery_codes")
}

// C-MFA: desafio transitorio de login entre senha validada e TOTP confirmado.
model MfaLoginChallenge {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  challengeTokenHash String    @unique @map("challenge_token_hash")
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt         DateTime? @map("consumed_at") @db.Timestamptz(6)
  ipAddress          String?   @map("ip_address")
  userAgent          String?   @map("user_agent")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("mfa_login_challenges")
}

model UserClientScope {
  userId          String   @map("user_id") @db.Uuid
  clientId        String   @map("client_id") @db.Uuid
  grantedByUserId String?  @map("granted_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  grantedBy       User?    @relation("UserClientScopeGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, clientId])
  @@index([clientId])
  @@map("user_client_scopes")
}

model Permission {
  id              String           @id
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role         String     @map("role")
  permissionId String     @map("permission_id")
  roleRef      Role       @relation(fields: [role], references: [code], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@map("role_permissions")
}

model UserSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  sessionTokenHash String    @unique @map("session_token_hash")
  csrfTokenHash    String    @map("csrf_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz(6)
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Site {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String       @map("client_id") @db.Uuid
  name      String
  code      String
  city      String?
  state     String?
  timezone  String?
  status    EntityStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  nodes     Node[]

  @@unique([clientId, code])
  @@map("sites")
}

model Node {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId          String              @map("site_id") @db.Uuid
  nodeUid         String              @unique @map("node_uid")
  nodeUidStatus   NodeUidStatus       @default(active) @map("node_uid_status")
  hostname        String
  displayName     String?             @map("display_name")
  managementIp    String?             @map("management_ip")
  wanIp           String?             @map("wan_ip")
  remoteAccessUrl String?             @map("remote_access_url")
  pfsenseVersion  String?             @map("pfsense_version")
  agentVersion    String?             @map("agent_version")
  haRole          String?             @map("ha_role")
  lastBootAt      DateTime?           @map("last_boot_at") @db.Timestamptz(6)
  lastSeenAt      DateTime?           @map("last_seen_at") @db.Timestamptz(6)
  lastHeartbeatId String?             @map("last_heartbeat_id")
  lastHeartbeatSentAt DateTime?       @map("last_heartbeat_sent_at") @db.Timestamptz(6)
  lastLatencyMs   Int?                @map("last_latency_ms")
  uptimeSeconds   Int?                @map("uptime_seconds")
  cpuPercent      Float?              @map("cpu_percent")
  memoryPercent   Float?              @map("memory_percent")
  diskPercent     Float?              @map("disk_percent")
  schemaVersion   String?             @map("schema_version")
  customerCode    String?             @map("customer_code")
  networkInterfacesJson Json?         @map("network_interfaces_json")
  localUsersSnapshotJson Json?       @map("local_users_snapshot_json")
  status          NodeStatus          @default(unknown)
  maintenanceMode Boolean             @default(false) @map("maintenance_mode")
  criticality     NodeCriticality     @default(standard)
  pfsenseUpdateAvailable    Boolean?  @map("pfsense_update_available")
  pfsenseUpdateTargetVersion String?  @map("pfsense_update_target_version")
  pfsenseUpdateCheckedAt    DateTime? @map("pfsense_update_checked_at") @db.Timestamptz(6)
  pfsenseUpdateCheckError   String?   @map("pfsense_update_check_error")
  pfsenseUpdateForceCheckAt DateTime? @map("pfsense_update_force_check_at") @db.Timestamptz(6)
  pfsenseUpdateErrorClass   String?   @map("pfsense_update_error_class")
  pfsenseUpdateLogSnippet   String?   @map("pfsense_update_log_snippet")
  pfsenseRepoRepairRequestedAt DateTime? @map("pfsense_repo_repair_requested_at") @db.Timestamptz(6)
  haDetectedFromAgent       Boolean?  @map("ha_detected_from_agent")
  configBackupPolicyJson    Json?     @map("config_backup_policy_json")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  site            Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  credentials     NodeCredential[]
  agentTokens     AgentToken[]
  heartbeats      Heartbeat[]
  services        NodeServiceStatus[]
  gateways        NodeGatewayStatus[]
  alerts          Alert[]
  configBackups   NodeConfigBackup[]
  nodeCommands    NodeCommand[]
  requestNonces   NodeRequestNonce[]
  nodeTags        NodeTag[]
  groupMembers    NodeGroupMember[]
  metricSamples   NodeMetricSample[]
  metricRollupsHourly NodeMetricRollupHourly[]
  metricRollupsDaily  NodeMetricRollupDaily[]
  certificates        NodeCertificate[]
  capability          NodeCapability?
  externalCredentials NodeExternalCredential[]
  credentialEvents    NodeCredentialEvent[]
  technicianAccounts  TechnicianNodeAccount[]

  @@index([siteId, status])
  @@index([criticality])
  @@map("nodes")
}

model Tag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  nodeTags  NodeTag[]

  @@unique([clientId, name])
  @@index([clientId])
  @@map("tags")
}

model NodeTag {
  nodeId    String   @map("node_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([nodeId, tagId])
  @@index([tagId])
  @@map("node_tags")
}

model NodeGroup {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String            @map("client_id") @db.Uuid
  name        String
  description String?
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  members     NodeGroupMember[]

  @@unique([clientId, name])
  @@index([clientId])
  @@map("node_groups")
}

model NodeGroupMember {
  groupId   String    @map("group_id") @db.Uuid
  nodeId    String    @map("node_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  group     NodeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  node      Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([groupId, nodeId])
  @@index([nodeId])
  @@map("node_group_members")
}

// C2: anti-replay HMAC — assinaturas ja vistas por node, com TTL = janela de skew.
model NodeRequestNonce {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId        String   @map("node_id") @db.Uuid
  signatureHash String   @map("signature_hash")
  seenAt        DateTime @default(now()) @map("seen_at") @db.Timestamptz(6)
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(6)
  node          Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, signatureHash])
  @@index([expiresAt])
  @@map("node_request_nonces")
}

// C-RL: rate-limit persistente do endpoint publico de release/artefato.
// Substitui o contador in-memory: sobrevive a restart e e compartilhado entre
// instancias (janela fixa por chave de origem). Limite mantido em 60 req/min.
model PackageReleaseRateLimit {
  rateKey     String   @id @map("rate_key")
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([windowStart])
  @@map("package_release_rate_limits")
}

model NodeCredential {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId          String               @map("node_id") @db.Uuid
  secretHint      String               @map("secret_hint")
  secretHash      String               @map("secret_hash")
  secretEncrypted String               @map("secret_encrypted")
  status          NodeCredentialStatus @default(active)
  rotatedAt       DateTime?            @map("rotated_at") @db.Timestamptz(6)
  lastUsedAt      DateTime?            @map("last_used_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt       DateTime?            @map("revoked_at") @db.Timestamptz(6)
  node            Node                 @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, status])
  @@map("node_credentials")
}

model AgentToken {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId     String           @map("node_id") @db.Uuid
  tokenHint  String           @map("token_hint")
  tokenHash  String           @map("token_hash")
  status     AgentTokenStatus @default(active)
  expiresAt  DateTime?        @map("expires_at") @db.Timestamptz(6)
  lastUsedAt DateTime?        @map("last_used_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt  DateTime?        @map("revoked_at") @db.Timestamptz(6)
  node       Node             @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, status])
  @@map("agent_tokens")
}

model Heartbeat {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId         String    @map("node_id") @db.Uuid
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  sentAt         DateTime  @map("sent_at") @db.Timestamptz(6)
  heartbeatId    String    @unique @map("heartbeat_id")
  latencyMs      Int?      @map("latency_ms")
  pfsenseVersion String?   @map("pfsense_version")
  agentVersion   String?   @map("agent_version")
  managementIp   String?   @map("management_ip")
  wanIp          String?   @map("wan_ip")
  uptimeSeconds  Int?      @map("uptime_seconds")
  cpuPercent     Float?    @map("cpu_percent")
  memoryPercent  Float?    @map("memory_percent")
  diskPercent    Float?    @map("disk_percent")
  gatewaySummary Json?     @map("gateway_summary")
  schemaVersion  String    @map("schema_version")
  customerCode   String    @map("customer_code")
  payloadJson    Json      @map("payload_json")
  node           Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, receivedAt])
  @@map("heartbeats")
}

model NodeServiceStatus {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId      String        @map("node_id") @db.Uuid
  serviceName String        @map("service_name")
  status      ServiceStatus
  message     String?
  observedAt  DateTime      @map("observed_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  node        Node          @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, serviceName])
  @@map("node_service_status")
}

model NodeGatewayStatus {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId      String        @map("node_id") @db.Uuid
  gatewayName String        @map("gateway_name")
  status      GatewayStatus
  lossPercent Float?        @map("loss_percent")
  latencyMs   Float?        @map("latency_ms")
  observedAt  DateTime      @map("observed_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  node        Node          @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, gatewayName])
  @@map("node_gateway_status")
}

model NodeCertificate {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId          String   @map("node_id") @db.Uuid
  certKey         String   @map("cert_key")
  subject         String
  issuer          String?
  usageDescriptor String?  @map("usage_descriptor")
  notBefore       DateTime @map("not_before") @db.Timestamptz(6)
  notAfter        DateTime @map("not_after") @db.Timestamptz(6)
  observedAt      DateTime @map("observed_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  node            Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, certKey])
  @@index([nodeId, notAfter])
  @@map("node_certificates")
}

model NodeCapability {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId           String                   @unique @map("node_id") @db.Uuid
  pfrestEnabled    Boolean?                 @map("pfrest_enabled")
  pfrestVersion    String?                  @map("pfrest_version")
  apiBaseUrl       String?                  @map("api_base_url")
  accessMode       NodeCapabilityAccessMode @default(unknown) @map("access_mode")
  authMethod       String?                  @map("auth_method")
  capabilitiesJson Json?                    @map("capabilities_json")
  lastReportedAt   DateTime?                @map("last_reported_at") @db.Timestamptz(6)
  lastProbeAt      DateTime?                @map("last_probe_at") @db.Timestamptz(6)
  lastSuccessAt    DateTime?                @map("last_success_at") @db.Timestamptz(6)
  lastError        String?                  @map("last_error")
  observedAt       DateTime                 @map("observed_at") @db.Timestamptz(6)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  node             Node                     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@map("node_capabilities")
}

model NodeExternalCredential {
  id               String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId           String                           @map("node_id") @db.Uuid
  credentialType   NodeExternalCredentialType       @default(pfrest_api) @map("credential_type")
  authMethod       NodeExternalCredentialAuthMethod @map("auth_method")
  secretHint       String                           @map("secret_hint")
  secretEncrypted  String                           @map("secret_encrypted")
  status           NodeExternalCredentialStatus     @default(active)
  scopeDescription String?                          @map("scope_description")
  rotatedAt        DateTime?                        @map("rotated_at") @db.Timestamptz(6)
  lastTestedAt     DateTime?                        @map("last_tested_at") @db.Timestamptz(6)
  lastTestResult   String?                          @map("last_test_result")
  createdBy        String?                          @map("created_by") @db.Uuid
  revokedAt        DateTime?                        @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)
  node             Node                             @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  events           NodeCredentialEvent[]

  @@index([nodeId, status])
  @@index([nodeId, credentialType, status])
  @@map("node_external_credentials")
}

model NodeCredentialEvent {
  id           String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId       String                  @map("node_id") @db.Uuid
  credentialId String?                 @map("credential_id") @db.Uuid
  eventType    NodeCredentialEventType @map("event_type")
  actorId      String?                 @map("actor_id") @db.Uuid
  result       String                  @default("success")
  metadataJson Json?                   @map("metadata_json")
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  node         Node                    @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  credential   NodeExternalCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([nodeId, createdAt])
  @@index([credentialId])
  @@map("node_credential_events")
}

model Alert {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId         String        @map("node_id") @db.Uuid
  fingerprint    String        @unique
  type           AlertType
  severity       AlertSeverity
  title          String
  description    String
  status         AlertStatus   @default(open)
  metadataJson   Json?         @map("metadata_json")
  openedAt       DateTime      @map("opened_at") @db.Timestamptz(6)
  acknowledgedAt DateTime?     @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedBy String?       @map("acknowledged_by")
  resolvedAt     DateTime?     @map("resolved_at") @db.Timestamptz(6)
  resolutionNote String?       @map("resolution_note")
  node           Node          @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  notificationDeliveries NotificationDelivery[]

  @@index([nodeId, status, severity])
  @@map("alerts")
}

model NodeConfigBackup {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId            String             @map("node_id") @db.Uuid
  commandId         String?            @map("command_id") @db.Uuid
  backupUid         String             @unique @map("backup_uid")
  attemptId         String?            @map("attempt_id")
  status            ConfigBackupStatus @default(stored)
  source            String             @default("scheduled") @map("source")
  receivedAt        DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  sentAt            DateTime?          @map("sent_at") @db.Timestamptz(6)
  configSha256      String             @map("config_sha256")
  payloadSha256     String             @map("payload_sha256")
  sizeBytes         Int                @map("size_bytes")
  payloadSizeBytes  Int                @map("payload_size_bytes")
  compression       String?            @map("compression")
  storagePath       String?            @map("storage_path")
  encryptionVersion String?            @map("encryption_version")
  agentVersion      String?            @map("agent_version")
  pfsenseVersion    String?            @map("pfsense_version")
  failureReason     String?            @map("failure_reason")
  metadataJson      Json?              @map("metadata_json")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  node              Node               @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  command           NodeCommand?       @relation(fields: [commandId], references: [id], onDelete: SetNull)

  @@index([nodeId, receivedAt])
  @@index([nodeId, configSha256])
  @@index([commandId])
  @@index([attemptId])
  @@map("node_config_backups")
}

model JobBatch {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commandType       NodeCommandType @map("command_type")
  status            JobBatchStatus  @default(pending)
  requestedByUserId String?         @map("requested_by_user_id") @db.Uuid
  clientId          String?         @map("client_id") @db.Uuid
  label             String?
  metadataJson      Json?           @map("metadata_json")
  totalCount        Int             @default(0) @map("total_count")
  succeededCount    Int             @default(0) @map("succeeded_count")
  failedCount       Int             @default(0) @map("failed_count")
  cancelledCount    Int             @default(0) @map("cancelled_count")
  expiredCount      Int             @default(0) @map("expired_count")
  requestedAt       DateTime        @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt       DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  commands          NodeCommand[]

  @@index([status])
  @@index([requestedAt])
  @@map("job_batches")
}

model NodeCommand {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId            String            @map("node_id") @db.Uuid
  type              NodeCommandType
  status            NodeCommandStatus @default(pending)
  requestedByUserId String?           @map("requested_by_user_id") @db.Uuid
  requestedAt       DateTime          @default(now()) @map("requested_at") @db.Timestamptz(6)
  pickedUpAt        DateTime?         @map("picked_up_at") @db.Timestamptz(6)
  runningAt         DateTime?         @map("running_at") @db.Timestamptz(6)
  completedAt       DateTime?         @map("completed_at") @db.Timestamptz(6)
  expiresAt         DateTime          @map("expires_at") @db.Timestamptz(6)
  payloadJson       Json?             @map("payload_json")
  resultJson        Json?             @map("result_json")
  errorMessage      String?           @map("error_message")
  batchId           String?           @map("batch_id") @db.Uuid
  idempotencyKey    String?           @map("idempotency_key")
  retryCount        Int               @default(0) @map("retry_count")
  maxRetries        Int               @default(0) @map("max_retries")
  nextRetryAt       DateTime?         @map("next_retry_at") @db.Timestamptz(6)
  cancelledAt       DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  cancelledByUserId String?           @map("cancelled_by_user_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  node              Node              @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  batch             JobBatch?         @relation(fields: [batchId], references: [id], onDelete: SetNull)
  configBackups     NodeConfigBackup[]

  @@index([nodeId, status])
  @@index([expiresAt])
  @@index([batchId])
  @@index([nextRetryAt])
  @@map("node_commands")
}

model AuditLog {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorType    String    @map("actor_type")
  actorId      String?   @map("actor_id")
  actorRole    String?   @map("actor_role")
  clientId     String?   @map("client_id") @db.Uuid
  action       String
  targetType   String    @map("target_type")
  targetId     String?   @map("target_id")
  result       String    @default("success")
  ipAddress    String?   @map("ip_address")
  metadataJson Json?     @map("metadata_json")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, targetType, createdAt])
  @@index([clientId, createdAt])
  @@index([result, createdAt])
  @@map("audit_logs")
}

model NotificationChannel {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  type             NotificationChannelType
  status           NotificationChannelStatus @default(active)
  configPublicJson Json                      @map("config_public_json")
  secretsEncrypted String?                   @map("secrets_encrypted")
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  rules            NotificationRule[]
  deliveries       NotificationDelivery[]

  @@index([status, type])
  @@map("notification_channels")
}

model NotificationRule {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  enabled   Boolean             @default(true)
  severity  AlertSeverity?
  alertType AlertType?          @map("alert_type")
  clientId  String?             @map("client_id") @db.Uuid
  channelId String              @map("channel_id") @db.Uuid
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  channel   NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  client    Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([enabled, channelId])
  @@index([clientId])
  @@map("notification_rules")
}

model NotificationDelivery {
  id             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alertId        String                     @map("alert_id") @db.Uuid
  channelId      String                     @map("channel_id") @db.Uuid
  idempotencyKey String                     @unique @map("idempotency_key")
  status         NotificationDeliveryStatus @default(pending)
  attemptCount   Int                        @default(0) @map("attempt_count")
  lastError      String?                    @map("last_error")
  sentAt         DateTime?                  @map("sent_at") @db.Timestamptz(6)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  alert          Alert                      @relation(fields: [alertId], references: [id], onDelete: Cascade)
  channel        NotificationChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([alertId, createdAt])
  @@index([channelId, status])
  @@map("notification_deliveries")
}

// Fase 6 plano 117: amostras periodicas do snapshot operacional (nao e heartbeat bruto).
model NodeMetricSample {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId            String     @map("node_id") @db.Uuid
  sampledAt         DateTime   @map("sampled_at") @db.Timestamptz(6)
  status            NodeStatus
  cpuPercent        Float?     @map("cpu_percent")
  memoryPercent     Float?     @map("memory_percent")
  diskPercent       Float?     @map("disk_percent")
  latencyMs         Int?       @map("latency_ms")
  availabilityScore Float      @default(0) @map("availability_score")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  node              Node       @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, sampledAt])
  @@map("node_metric_samples")
}

model NodeMetricRollupHourly {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId          String   @map("node_id") @db.Uuid
  bucketStart     DateTime @map("bucket_start") @db.Timestamptz(6)
  sampleCount     Int      @default(0) @map("sample_count")
  cpuAvg          Float?   @map("cpu_avg")
  cpuMin          Float?   @map("cpu_min")
  cpuMax          Float?   @map("cpu_max")
  memoryAvg       Float?   @map("memory_avg")
  memoryMin       Float?   @map("memory_min")
  memoryMax       Float?   @map("memory_max")
  diskAvg         Float?   @map("disk_avg")
  diskMin         Float?   @map("disk_min")
  diskMax         Float?   @map("disk_max")
  latencyAvg      Float?   @map("latency_avg")
  latencyMin      Float?   @map("latency_min")
  latencyMax      Float?   @map("latency_max")
  availabilityPct Float?   @map("availability_pct")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  node            Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, bucketStart])
  @@index([bucketStart])
  @@map("node_metric_rollups_hourly")
}

