generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EntityStatus {
  active
  inactive

  @@map("entity_status")
}

enum NodeStatus {
  online
  degraded
  offline
  maintenance
  unknown

  @@map("node_status")
}

enum ServiceStatus {
  running
  stopped
  degraded
  unknown
  not_installed

  @@map("service_status")
}

enum GatewayStatus {
  online
  degraded
  down
  unknown

  @@map("gateway_status")
}

enum AlertStatus {
  open
  acknowledged
  resolved

  @@map("alert_status")
}

enum AlertType {
  heartbeat_missing
  service_down
  gateway_down
  version_change
  agent_error
  node_uid_conflict
  clock_skew
  auth_failure_repeated

  @@map("alert_type")
}

enum AlertSeverity {
  critical
  warning
  info

  @@map("alert_severity")
}

enum NodeUidStatus {
  active
  conflict
  retired

  @@map("node_uid_status")
}

enum NodeCredentialStatus {
  active
  rotated
  revoked

  @@map("node_credential_status")
}

enum AgentTokenStatus {
  active
  expired
  revoked

  @@map("agent_token_status")
}

enum ConfigBackupStatus {
  stored
  duplicate
  rejected
  failed

  @@map("config_backup_status")
}

enum NodeCommandType {
  config_backup_now
  pfsense_upgrade

  @@map("node_command_type")
}

enum NodeCommandStatus {
  pending
  picked_up
  running
  succeeded
  failed
  expired
  cancelled

  @@map("node_command_status")
}

model Role {
  code             String           @id
  label            String
  isSystem         Boolean          @default(false) @map("is_system")
  status           EntityStatus     @default(active)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  users            User[]
  rolePermissions  RolePermission[]

  @@map("roles")
}

model Client {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  code      String       @unique
  status    EntityStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  sites     Site[]
  userScopes UserClientScope[]
  clientUsers User[] @relation("ClientProfileUsers")
  auditLogs AuditLog[]

  @@map("clients")
}

model User {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String       @unique
  displayName String?      @map("display_name")
  passwordHash String?     @map("password_hash")
  role        String       @default("readonly")
  status      EntityStatus @default(active)
  clientId    String?      @map("client_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions    UserSession[]
  roleRef     Role         @relation(fields: [role], references: [code], onDelete: Restrict)
  client      Client?      @relation("ClientProfileUsers", fields: [clientId], references: [id], onDelete: SetNull)
  clientScopes UserClientScope[]
  grantedClientScopes UserClientScope[] @relation("UserClientScopeGrantedBy")

  @@index([clientId])
  @@map("users")
}

model UserClientScope {
  userId          String   @map("user_id") @db.Uuid
  clientId        String   @map("client_id") @db.Uuid
  grantedByUserId String?  @map("granted_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  grantedBy       User?    @relation("UserClientScopeGrantedBy", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, clientId])
  @@index([clientId])
  @@map("user_client_scopes")
}

model Permission {
  id              String           @id
  description     String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role         String     @map("role")
  permissionId String     @map("permission_id")
  roleRef      Role       @relation(fields: [role], references: [code], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@map("role_permissions")
}

model UserSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  sessionTokenHash String    @unique @map("session_token_hash")
  csrfTokenHash    String    @map("csrf_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz(6)
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Site {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId  String       @map("client_id") @db.Uuid
  name      String
  code      String
  city      String?
  state     String?
  timezone  String?
  status    EntityStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  client    Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  nodes     Node[]

  @@unique([clientId, code])
  @@map("sites")
}

model Node {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId          String              @map("site_id") @db.Uuid
  nodeUid         String              @unique @map("node_uid")
  nodeUidStatus   NodeUidStatus       @default(active) @map("node_uid_status")
  hostname        String
  displayName     String?             @map("display_name")
  managementIp    String?             @map("management_ip")
  wanIp           String?             @map("wan_ip")
  pfsenseVersion  String?             @map("pfsense_version")
  agentVersion    String?             @map("agent_version")
  haRole          String?             @map("ha_role")
  lastBootAt      DateTime?           @map("last_boot_at") @db.Timestamptz(6)
  lastSeenAt      DateTime?           @map("last_seen_at") @db.Timestamptz(6)
  lastHeartbeatId String?             @map("last_heartbeat_id")
  lastHeartbeatSentAt DateTime?       @map("last_heartbeat_sent_at") @db.Timestamptz(6)
  lastLatencyMs   Int?                @map("last_latency_ms")
  uptimeSeconds   Int?                @map("uptime_seconds")
  cpuPercent      Float?              @map("cpu_percent")
  memoryPercent   Float?              @map("memory_percent")
  diskPercent     Float?              @map("disk_percent")
  schemaVersion   String?             @map("schema_version")
  customerCode    String?             @map("customer_code")
  networkInterfacesJson Json?         @map("network_interfaces_json")
  status          NodeStatus          @default(unknown)
  maintenanceMode Boolean             @default(false) @map("maintenance_mode")
  pfsenseUpdateAvailable    Boolean?  @map("pfsense_update_available")
  pfsenseUpdateTargetVersion String?  @map("pfsense_update_target_version")
  pfsenseUpdateCheckedAt    DateTime? @map("pfsense_update_checked_at") @db.Timestamptz(6)
  pfsenseUpdateCheckError   String?   @map("pfsense_update_check_error")
  haDetectedFromAgent       Boolean?  @map("ha_detected_from_agent")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  site            Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  credentials     NodeCredential[]
  agentTokens     AgentToken[]
  heartbeats      Heartbeat[]
  services        NodeServiceStatus[]
  gateways        NodeGatewayStatus[]
  alerts          Alert[]
  configBackups   NodeConfigBackup[]
  nodeCommands    NodeCommand[]

  @@index([siteId, status])
  @@map("nodes")
}

model NodeCredential {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId          String               @map("node_id") @db.Uuid
  secretHint      String               @map("secret_hint")
  secretHash      String               @map("secret_hash")
  secretEncrypted String               @map("secret_encrypted")
  status          NodeCredentialStatus @default(active)
  rotatedAt       DateTime?            @map("rotated_at") @db.Timestamptz(6)
  lastUsedAt      DateTime?            @map("last_used_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt       DateTime?            @map("revoked_at") @db.Timestamptz(6)
  node            Node                 @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, status])
  @@map("node_credentials")
}

model AgentToken {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId     String           @map("node_id") @db.Uuid
  tokenHint  String           @map("token_hint")
  tokenHash  String           @map("token_hash")
  status     AgentTokenStatus @default(active)
  expiresAt  DateTime?        @map("expires_at") @db.Timestamptz(6)
  lastUsedAt DateTime?        @map("last_used_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt  DateTime?        @map("revoked_at") @db.Timestamptz(6)
  node       Node             @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, status])
  @@map("agent_tokens")
}

model Heartbeat {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId         String    @map("node_id") @db.Uuid
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  sentAt         DateTime  @map("sent_at") @db.Timestamptz(6)
  heartbeatId    String    @unique @map("heartbeat_id")
  latencyMs      Int?      @map("latency_ms")
  pfsenseVersion String?   @map("pfsense_version")
  agentVersion   String?   @map("agent_version")
  managementIp   String?   @map("management_ip")
  wanIp          String?   @map("wan_ip")
  uptimeSeconds  Int?      @map("uptime_seconds")
  cpuPercent     Float?    @map("cpu_percent")
  memoryPercent  Float?    @map("memory_percent")
  diskPercent    Float?    @map("disk_percent")
  gatewaySummary Json?     @map("gateway_summary")
  schemaVersion  String    @map("schema_version")
  customerCode   String    @map("customer_code")
  payloadJson    Json      @map("payload_json")
  node           Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, receivedAt])
  @@map("heartbeats")
}

model NodeServiceStatus {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId      String        @map("node_id") @db.Uuid
  serviceName String        @map("service_name")
  status      ServiceStatus
  message     String?
  observedAt  DateTime      @map("observed_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  node        Node          @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, serviceName])
  @@map("node_service_status")
}

model NodeGatewayStatus {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId      String        @map("node_id") @db.Uuid
  gatewayName String        @map("gateway_name")
  status      GatewayStatus
  lossPercent Float?        @map("loss_percent")
  latencyMs   Float?        @map("latency_ms")
  observedAt  DateTime      @map("observed_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  node        Node          @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, gatewayName])
  @@map("node_gateway_status")
}

model Alert {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId         String        @map("node_id") @db.Uuid
  fingerprint    String        @unique
  type           AlertType
  severity       AlertSeverity
  title          String
  description    String
  status         AlertStatus   @default(open)
  metadataJson   Json?         @map("metadata_json")
  openedAt       DateTime      @map("opened_at") @db.Timestamptz(6)
  acknowledgedAt DateTime?     @map("acknowledged_at") @db.Timestamptz(6)
  acknowledgedBy String?       @map("acknowledged_by")
  resolvedAt     DateTime?     @map("resolved_at") @db.Timestamptz(6)
  resolutionNote String?       @map("resolution_note")
  node           Node          @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, status, severity])
  @@map("alerts")
}

model NodeConfigBackup {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId            String             @map("node_id") @db.Uuid
  commandId         String?            @map("command_id") @db.Uuid
  backupUid         String             @unique @map("backup_uid")
  attemptId         String?            @map("attempt_id")
  status            ConfigBackupStatus @default(stored)
  source            String             @default("scheduled") @map("source")
  receivedAt        DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  sentAt            DateTime?          @map("sent_at") @db.Timestamptz(6)
  configSha256      String             @map("config_sha256")
  payloadSha256     String             @map("payload_sha256")
  sizeBytes         Int                @map("size_bytes")
  payloadSizeBytes  Int                @map("payload_size_bytes")
  compression       String?            @map("compression")
  storagePath       String?            @map("storage_path")
  encryptionVersion String?            @map("encryption_version")
  agentVersion      String?            @map("agent_version")
  pfsenseVersion    String?            @map("pfsense_version")
  failureReason     String?            @map("failure_reason")
  metadataJson      Json?              @map("metadata_json")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  node              Node               @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  command           NodeCommand?       @relation(fields: [commandId], references: [id], onDelete: SetNull)

  @@index([nodeId, receivedAt])
  @@index([nodeId, configSha256])
  @@index([commandId])
  @@index([attemptId])
  @@map("node_config_backups")
}

model NodeCommand {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nodeId            String            @map("node_id") @db.Uuid
  type              NodeCommandType
  status            NodeCommandStatus @default(pending)
  requestedByUserId String?           @map("requested_by_user_id") @db.Uuid
  requestedAt       DateTime          @default(now()) @map("requested_at") @db.Timestamptz(6)
  pickedUpAt        DateTime?         @map("picked_up_at") @db.Timestamptz(6)
  runningAt         DateTime?         @map("running_at") @db.Timestamptz(6)
  completedAt       DateTime?         @map("completed_at") @db.Timestamptz(6)
  expiresAt         DateTime          @map("expires_at") @db.Timestamptz(6)
  payloadJson       Json?             @map("payload_json")
  resultJson        Json?             @map("result_json")
  errorMessage      String?           @map("error_message")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  node              Node              @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  configBackups     NodeConfigBackup[]

  @@index([nodeId, status])
  @@index([expiresAt])
  @@map("node_commands")
}

model AuditLog {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorType    String    @map("actor_type")
  actorId      String?   @map("actor_id")
  actorRole    String?   @map("actor_role")
  clientId     String?   @map("client_id") @db.Uuid
  action       String
  targetType   String    @map("target_type")
  targetId     String?   @map("target_id")
  result       String    @default("success")
  ipAddress    String?   @map("ip_address")
  metadataJson Json?     @map("metadata_json")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, targetType, createdAt])
  @@index([clientId, createdAt])
  @@index([result, createdAt])
  @@map("audit_logs")
}
