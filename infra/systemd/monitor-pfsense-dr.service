[Unit]
Description=Monitor pfSense encrypted controller recovery to host 220 (LAN)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/etc/monitor-pfsense-dr/recipient.asc
ConditionPathExists=/etc/monitor-pfsense-dr/recipient.fingerprint

[Service]
Type=oneshot
User=root
WorkingDirectory=/Dados/Monitor-Pfsense
UMask=0077
Nice=15
IOSchedulingClass=idle
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /Dados/Monitor-Pfsense/scripts/backup-controller-dr.py backup --keys /etc/monitor-pfsense-dr
TimeoutStartSec=7200
KillMode=control-group
LimitCORE=0
