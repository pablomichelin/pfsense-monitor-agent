[Unit]
Description=Backup local verificado do PostgreSQL Monitor pfSense
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
WorkingDirectory=/Dados/Monitor-Pfsense
UMask=0077
Nice=15
IOSchedulingClass=idle
ExecStart=/bin/bash /Dados/Monitor-Pfsense/scripts/backup-postgres.sh
TimeoutStartSec=1800
