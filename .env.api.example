NODE_ENV=production
PORT=8088
DATABASE_URL=postgresql://monitor_pfsense:change-me@db:5432/monitor_pfsense?schema=public
SYSTEM_VERSION=0.8.0
TRUST_PROXY=false
TRUSTED_PROXY_IPS=192.168.100.253
HEARTBEAT_MAX_SKEW_SECONDS=300
NODE_DEGRADED_AFTER_SECONDS=90
NODE_OFFLINE_AFTER_SECONDS=300
NODE_RECONCILE_INTERVAL_SECONDS=30
AUTH_BOOTSTRAP_EMAIL=admin@systemup.inf.br
AUTH_BOOTSTRAP_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
AUTH_BOOTSTRAP_DISPLAY_NAME=SystemUp Admin
# E1 (gap MFA): em producao mantenha false. Login bootstrap so deve ficar true
# durante o PRIMEIRO provisionamento do superadmin; depois desligue.
# O bootstrap nunca regrava senha de usuario ja existente (ver auth.service.ts C1).
AUTH_BOOTSTRAP_LOGIN_ENABLED=false
# MFA: capacidade sempre disponivel. Politica persistida em mfa_policy_settings (painel /admin/mfa-politica).
# Env abaixo permanece override break-glass (prioridade sobre banco quando definido).
# MFA_ENFORCED_ROLES=admin,superadmin
# MFA_ENFORCEMENT_BLOCKING=false
AUTH_SESSION_COOKIE_NAME=monitor_pfsense_session
AUTH_CSRF_COOKIE_NAME=monitor_pfsense_csrf
AUTH_SESSION_TTL_HOURS=12
AUTH_COOKIE_SECURE=true
GATEWAY_DEGRADED_LATENCY_MS=150
GATEWAY_DEGRADED_LOSS_PERCENT=5
AGENT_BOOTSTRAP_RELEASE_BASE_URL=https://downloads.exemplo/monitor-pfsense
# Comando de instalacao package (exibido no painel por firewall e apos rotacionar secret)
PACKAGE_RELEASE_VERSION=0.4.6
PACKAGE_RELEASE_SHA256=a052bd22a67f0e86cc377643ba48a0908dcfb8d9706365bf4c58bf9842eb5704
# Opcional; default: GitHub do projeto
# PACKAGE_RELEASE_REPO_RAW_BASE=https://raw.githubusercontent.com/pablomichelin/pfsense-monitor-agent/main
# URL pública do controlador — tarball servido em /api/v1/agent/package-artifact
PACKAGE_RELEASE_PUBLIC_BASE_URL=https://pfs-monitor.systemup.inf.br
# generate with: openssl rand -base64 32
NODE_SECRET_ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_32_BYTE_KEY
# Chave separada para criptografia de backups config.xml (openssl rand -base64 32)
BACKUP_ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_32_BYTE_KEY
CONFIG_BACKUP_MAX_BYTES=5242880
CONFIG_BACKUP_RETENTION_COUNT=30
CONFIG_BACKUP_RETENTION_MAX_BYTES_PER_NODE=262144000
BACKUP_STORAGE_DIR=/app/data/pfsense-config-backups

# Backup avancado (Fase 5 plano 117) — desligado por padrao
BACKUP_DIFF_ENABLED=false
BACKUP_DRIFT_ENABLED=false

# Notificacoes externas (Fase 1 plano 117) — desligado por padrao
NOTIFICATIONS_ENABLED=false
# NOTIFICATIONS_MAX_ATTEMPTS=3
# NOTIFICATIONS_RETRY_DELAY_MS=5000

# Observabilidade historica / rollups (Fase 6 plano 117) — desligado por padrao
METRIC_ROLLUPS_ENABLED=false
# METRIC_SAMPLE_INTERVAL_SECONDS=300
# METRIC_SAMPLE_RETENTION_HOURS=72
# METRIC_HOURLY_ROLLUP_INTERVAL_SECONDS=3600
# METRIC_DAILY_ROLLUP_INTERVAL_SECONDS=86400
# METRIC_HOURLY_RETENTION_DAYS=35
# METRIC_DAILY_RETENTION_DAYS=400

# Fundacao jobs/comandos (Fase 7 plano 117) — worker desligado por padrao
COMMAND_WORKER_ENABLED=false
# COMMAND_WORKER_INTERVAL_SECONDS=30
# COMMAND_WORKER_LOCK_TTL_SECONDS=120
# COMMAND_HISTORY_DEFAULT_LIMIT=25
# CONFIG_BACKUP_COMMAND_MAX_RETRIES=2
# PFSENSE_UPGRADE_COMMAND_MAX_RETRIES=1
# PACKAGE_UPGRADE_COMMAND_MAX_RETRIES=1

# Ações operacionais allowlistadas (Fase 8) — default desligado
OPERATIONAL_ACTIONS_ENABLED=false
SERVICE_RESTART_ENABLED=false
NODE_REBOOT_ENABLED=false
# OPERATIONAL_ACTIONS_COMMAND_EXPIRE_MINUTES=15
# OPERATIONAL_ACTIONS_MIN_AGENT_VERSION=0.4.8
# NODE_REBOOT_DEFAULT_DELAY_SECONDS=60
# SERVICE_RESTART_COMMAND_MAX_RETRIES=1

# Certificados e expiracao (Fase 9 plano 117) — desligado por padrao
CERTIFICATES_ENABLED=false
# CERTIFICATES_MIN_AGENT_VERSION=0.4.9

# Capacidades pfREST + vault (Fase 10 plano 117) — desligado por padrao
NODE_CAPABILITIES_ENABLED=false
PFSENSE_VAULT_ENABLED=false
# PFSENSE_VAULT_TEST_TIMEOUT_MS=5000

# pfREST read-only / alias piloto (Fase 11 plano 117) — desligado por padrao
PFSENSE_API_ENABLED=false
PFSENSE_ALIAS_READ_ENABLED=false
PFSENSE_ALIAS_APPLY_ENABLED=false
# PFSENSE_ALIAS_REQUIRE_BACKUP_HOURS=24

# Upgrade remoto pfSense OS (por firewall)
PFSENSE_UPGRADE_ENABLED=false
PFSENSE_UPGRADE_COMMAND_EXPIRE_MINUTES=120
PFSENSE_UPGRADE_OFFLINE_GRACE_MINUTES=90
PFSENSE_UPGRADE_LATE_RESULT_RECONCILE_HOURS=24
PFSENSE_UPGRADE_MAX_CONCURRENT=0
PFSENSE_UPGRADE_MIN_AGENT_VERSION=0.3.1
PFSENSE_UPGRADE_REQUIRE_BACKUP_HOURS=24
# Informativo; throttle real no agente (MONITOR_AGENT_PFSENSE_UPDATE_CHECK_INTERVAL_HOURS)
PFSENSE_UPGRADE_UPDATE_CHECK_INTERVAL_HOURS=6

# Contas locais de tecnicos pfSense (Fase 0 plano 144) — default desligado
TECHNICIAN_ACCOUNTS_ENABLED=false
TECHNICIAN_ACCOUNT_CREATE_ENABLED=false
TECHNICIAN_ACCOUNT_PASSWORD_RESET_ENABLED=false
TECHNICIAN_ACCOUNT_DISABLE_ENABLED=false
TECHNICIAN_ACCOUNT_DELETE_ENABLED=false
# TECHNICIAN_ACCOUNT_COMMAND_EXPIRE_MINUTES=15
# TECHNICIAN_ACCOUNT_MIN_AGENT_VERSION=0.5.0
# TECHNICIAN_ACCOUNT_BATCH_MAX_SIZE=100
# TECHNICIAN_ACCOUNT_COMMAND_MAX_RETRIES=1
# TECHNICIAN_ACCOUNT_COMMAND_RETRY_BACKOFF_MS_1=60000
# Gate de backup recente (doc 154) — bloqueia create/set_password/disable/delete
# de usuarios locais se o node nao tiver backup de config.xml dentro da janela.
# Default: ligado, janela de 7 dias (168h).
TECHNICIAN_ACCOUNT_REQUIRE_RECENT_BACKUP_ENABLED=true
TECHNICIAN_ACCOUNT_REQUIRE_BACKUP_MAX_AGE_HOURS=168
